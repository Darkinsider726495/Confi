# ===== FRIDAY — copie para .env (chmod 600) =====

# --- Cérebro ---
# Provedor de nuvem: groq (API externa com modelos Llama) ou anthropic.
# Para usar Groq, crie uma chave em https://console.groq.com/ e configure GROQ_API_KEY.
# IA_PROVEDOR=groq faz a FRIDAY usar Groq e NÃO recorrer à Anthropic.
IA_PROVEDOR=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Não configure a chave em código. Guarde .env com chmod 600.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Local de reserva. Se o Ollama roda no servidor da pilha, use o IP do Tailscale dele.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Teto de chamadas à IA por dia (protege seu bolso se algo entrar em laço)
LIMITE_DIARIO=200

# --- Segurança ---
# PIN das ações de nível 3 (trancar/abrir, relés críticos). Sem PIN definido, essas ações NUNCA são liberadas.
FRIDAY_PIN=
# Push privado (ntfy da pilha do servidor). Ex.: http://100.x.y.z:2586/friday
# O ntfy do servidor nega acesso anônimo: gere um token (README do servidor) e coloque abaixo.
NTFY_URL=
NTFY_TOKEN=
# Relés: nome:pino:nível  (0-1 liga na hora; 2 pede "confirmo"; 3 exige PIN). Sem nível = 2 (pede confirmação falada).
# RELES=luz:17:1,ventilador:27:1
# Relés de nível 2+ desligam sozinhos depois deste tempo (segundos)
RELE_TTL_CRITICO=600

# --- Personalidade e voz (estilo JARVIS) ---
# Como ela chama você ("sim, chefe"). Padrão: chefe
TRATAMENTO=chefe
# Voz do Android: velocidade e tom. 1.0 = normal. Um pouco mais lenta e grave soa mais "JARVIS"; teste no seu aparelho (0.3 a 3.0).
# TTS_VELOCIDADE=0.92
# TTS_TOM=0.85
# Clima do painel e do briefing (Open-Meteo, sem chave). Padrão: São Paulo
# CLIMA_LAT=-23.55
# CLIMA_LON=-46.63
# CLIMA_LOCAL=São Paulo
# Protocolos próprios: copie friday/protocolos.exemplo.json para protocolos.json (na raiz) e edite. Veja docs/ANDROID.md.
# FRIDAY_PROTOCOLOS=

# --- Celular Android (Termux) ---
# Contatos que ela pode usar para SMS, ligação e WhatsApp. Só estes: nome:número com DDI e DDD, separados por vírgula.
# CONTATOS=mae:+5511999999999,socio:+5511988888888
# Horário em que ela NÃO fala em voz alta (só notifica)
SILENCIO=22:00-07:00
# Pesquisa na internet: sem chave usa o DuckDuckGo; com chave da Brave Search API fica mais estável
BRAVE_API_KEY=

# --- Voz (Raspberry Pi / PC) ---
WAKE_MODEL=hey_jarvis
WAKE_LIMIAR=0.5
VAD_LIMIAR=350
WHISPER_MODEL=base

# --- HUD (tela) ---
# 127.0.0.1 = só neste aparelho. Para abrir de outro aparelho use o IP do Tailscale (nunca 0.0.0.0 sem firewall).
HUD_HOST=127.0.0.1
HUD_PORTA=8080

# --- Rotina ---
HORA_BRIEFING=08:00

# --- Leads do site (Supabase), opcional ---
# Ler leads exige a chave service_role (acesso total ao banco): use só em aparelho seu e com este arquivo em chmod 600.
SUPABASE_URL=https://ptukmojfjdicworxpsnf.supabase.co
SUPABASE_SERVICE_KEY=

# --- Cérebro vivo (tudo ligado por padrão; ela funciona sozinha, sem botão de ligar) ---
# Cofre de memória (Obsidian). Vazio: usa Documents/Obsidian/Cofre FRIDAY no celular (ou a pasta cofre/ ao lado do projeto). "off" desliga a memória.
# OBSIDIAN_VAULT=
# Janela em que ela "dorme": fica quieta e consolida a memória (poda, equilíbrio, repasse, sonhos). Padrão 02:00-05:00; "off" desliga.
# DESCANSO=02:00-05:00
# Estado interno (dopamina, serotonina, acetilcolina, energia, humor, primeiras vezes). 0 desliga: a plasticidade volta a 1.0 e ela perde humor e energia.
# FRIDAY_VIDA=1
# Retomada ao ligar: depois de um reinício ou queda ela confere o que ficou pela metade e retoma só o que é seguro (nunca repete o que pode já ter acontecido e não dá para conferir). 0 desliga a parte automática; «retoma o que ficou pendente» por voz continua valendo.
# FRIDAY_RETOMADA=1
# Curiosidade: estuda sozinha na internet (quarentena na pasta Estudos) nas horas livres. 0 desliga.
# CURIOSIDADE=1
# Sem teto por padrão. Se quiser um limite de estudos por dia: CURIOSIDADE_MAX_DIA=40  (0 = sem teto)
# CURIOSIDADE_MAX_DIA=0
# Minutos mínimos entre dois estudos por iniciativa dela
# CURIOSIDADE_INTERVALO_MIN=10
# Conversa espontânea (puxa assunto, pergunta, conta o que estudou, brinca). 0 desliga. Sem teto por padrão.
# CONVERSA=1
# CONVERSA_MAX_DIA=0
# CONVERSA_INTERVALO_MIN=90
# Memória automática: descobrir sinapses, consolidar. 0 desliga.
# MEMORIA_AUTO=1
# MEMORIA_DESCOBRIR=1

# --- Busca na memória: sem teto por padrão. Só estas linhas, se VOCÊ quiser economizar processamento/RAM (aparelho fraco) ---
# CEREBRO_MAX_ARQUIVOS=0       quantas notas a busca lê; 0 = todas. Com um valor, ficam as MAIS RECENTES (nunca o começo do alfabeto). Não vale para o cofre externo (OBSIDIAN_LER_TUDO=1), que lê as 3.000 mais recentes e avisa quando corta
# CEREBRO_CACHE_NOTAS=0        quantas notas ficam lidas em RAM; 0 = o cofre inteiro (mínimo 20.000). Menos RAM = mais releitura de arquivos, nunca perda de memória

# --- Sinapses: sem teto. Só estas linhas, se VOCÊ quiser limitar (aparelho fraco). 0 = sem limite (padrão) ---
# CEREBRO_MAX_SINAPSES=0       quantas sinapses ficam ativas (acima disso as mais fracas ADORMECEM em .cerebro/dormentes.json; nada é apagado)
# CEREBRO_MAX_USO=0            contagens de uso por neurônio
# CEREBRO_MAX_DESC=0           candidatas a sinapse em observação
# CEREBRO_DESC_NOITE=0         novas sinapses descobertas por consolidação
# CEREBRO_DESC_CICLO=0         ... por devaneio
# CEREBRO_DESC_DIA=0           ... por dia
# CEREBRO_SONHOS_NOITE=0       ligações «sonhadas» por noite
# Não limita a QUANTIDADE: só reescala a força total de cada neurônio no sono, para nenhum virar «centro de tudo». 0 desliga.
# CEREBRO_HOMEOSTASE=14

# --- Visão (lobo occipital): ela enxerga, aprende o que vê e nunca apaga ---
# De onde vêm os olhos: auto (celular > url > picam > webcam > navegador), termux, navegador, webcam, picam, url, off.
# VISAO_FONTE=auto
# Câmera do celular (termux-camera-photo): 0 = traseira, 1 = frontal. No navegador, 1 = frontal.
# VISAO_CAMERA=0
# Câmera por endereço (IP cam, ESP32-CAM, o corpo dela no futuro): só http(s); devolve uma foto JPEG a cada GET.
# VISAO_URL=
# Webcam USB
# VISAO_DISPOSITIVO=/dev/video0
# Olhar sozinha de vez em quando (nunca no descanso nem no silêncio). Você liga/desliga por voz: «olhe sozinha» / «não olhe mais sozinha». 0 = só quando você pedir.
# VISAO_AUTO=1
# VISAO_INTERVALO_MIN=10
# Modelo de visão local no Ollama (ex.: moondream, llava, qwen2.5vl). Vazio = usa a nuvem, se IA_MODO permitir.
# VISAO_MODELO_LOCAL=
# 0 = a foto nunca sai do aparelho (só o modelo local analisa)
# VISAO_NUVEM=1
# VISAO_MODELO=
# 1 = guarda também a foto (já sem localização e reduzida) em Visao/fotos/, para sempre. Padrão 0: só o texto do que ela entendeu.
# VISAO_GUARDAR_FOTOS=0

# ---------------------------------------------------------------- pré-córtex distribuído (docs/PRE_CORTEX.md)
# local (padrão: tudo neste processo) ou distribuido (neurônios em processos `python -m friday.pre_cortex.worker`)
# PRECORTEX_MODO=local
# PRECORTEX_WORKERS={"cognicao":{"url":"http://127.0.0.1:9101"},"revisao":{"url":"http://127.0.0.1:9102"}}
# Chave de sessão entre os processos (>= 16 caracteres). Gere uma sua; nunca a coloque em arquivo de configuração nem no git.
# PRECORTEX_TOKEN=
# PRECORTEX_CONFIG=friday/pre_cortex/config.exemplo.json
# PRECORTEX_PASTA=
# PRECORTEX_MAX_REPLANOS=3
# PRECORTEX_MAX_TEMPO_OBJETIVO_S=120
# PRECORTEX_RITMO_DEMO_S=0

# --- API local de evolução controlada ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FRIDAY_API_TOKEN=
FRIDAY_API_HOST=127.0.0.1
FRIDAY_API_PORT=8765
# Só use FRIDAY_API_ALLOW_REMOTE=yes se souber configurar TLS/firewall.


# --- Ponte híbrida da API local com modelos ---
# Ordem: local_first (padrão) ou cloud_first
FRIDAY_HYBRID_ORDER=local_first
# Se Ollama falhar, permitir fallback para Groq. O texto enviado à nuvem sai do aparelho.
FRIDAY_HYBRID_CLOUD_FALLBACK=yes
FRIDAY_HYBRID_LOCAL_TIMEOUT=45
FRIDAY_HYBRID_CLOUD_TIMEOUT=35
# Para privacidade estrita, defina FRIDAY_HYBRID_CLOUD_FALLBACK=no

# --- Busca semântica da memória (RAG) — integrada e ativa ---
# Precisa do lightrag (requirements-rag.txt) e do modelo de embedding no Ollama (ollama pull bge-m3).
# Sem isso instalado, a FRIDAY ignora e usa a busca por palavra normalmente.
# IMPORTANTE: valores sem comentário na mesma linha (o systemd EnvironmentFile não remove comentário inline).
# CEREBRO_RAG: 0 desliga a busca semântica.
CEREBRO_RAG=1
# CEREBRO_EMBED_MODEL: modelo de embedding no Ollama (multilíngue, bom em português).
CEREBRO_EMBED_MODEL=bge-m3:latest
# CEREBRO_EMBED_DIM: dimensão do embedding (a do bge-m3).
CEREBRO_EMBED_DIM=1024
# CEREBRO_RAG_DIR: pasta do índice (padrão <projeto>/.cerebro/rag, fora do cofre).
# CEREBRO_RAG_MODO: mix | hybrid | local | global | naive.
# CEREBRO_TOKENIZER: local (offline, conta em bytes) | tiktoken (baixa da internet 1x).

# Núcleo observacional (não controla o pré-córtex nem a concorrência)
NUCLEO=1
NUCLEO_FOCO=7
NUCLEO_HABITUACAO_S=300
NUCLEO_LIMIAR=0.25
