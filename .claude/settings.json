{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest discover -s tests -p *)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 friday/simbiose.py)",
      "Bash(python3 friday/main.py --diagnostico)",
      "Bash(bash -n *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Edit(./friday/broker.py)",
      "Edit(./friday/protocolos.py)",
      "Edit(./friday/acao.sh)",
      "Edit(./termux/**)",
      "Edit(./servidor/**)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(pip install *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.bak)",
      "Read(./**/.env)",
      "Read(./auditoria.jsonl)",
      "Read(./friday/auditoria.jsonl)",
      "Read(./**/*.key)",
      "Read(./cofre/**/Privado/**)",
      "Read(~/storage/shared/Documents/Obsidian/**/Privado/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.bak)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/simbiose.sh",
            "args": [],
            "timeout": 25
          }
        ]
      }
    ]
  }
}
