+def test_modo_local_bloqueia_groq_mesmo_com_fallback_habilitado(monkeypatch):
+    monkeypatch.setenv("IA_MODO", "local")
+    monkeypatch.setenv("FRIDAY_HYBRID_ORDER", "cloud_first")
+    monkeypatch.setenv("FRIDAY_HYBRID_CLOUD_FALLBACK", "yes")
+    monkeypatch.setenv("GROQ_API_KEY", "test-key")
+    session = Mock()
+    session.post.side_effect = OSError("offline")
+    with patch.object(ponte_ia, "_groq") as groq:
+        with pytest.raises(ponte_ia.PonteIAError):
+            ponte_ia.responder("conteúdo privado", session=session)
+    groq.assert_not_called()
+
+
+def test_modo_nuvem_nao_consulta_ollama(monkeypatch):
+    monkeypatch.setenv("IA_MODO", "nuvem")
+    monkeypatch.setenv("GROQ_API_KEY", "test-key")
+    session = Mock()
+    with patch.object(ponte_ia, "_ollama") as ollama, patch.object(ponte_ia, "_groq", return_value="resposta remota"):
+        result = ponte_ia.responder("oi", session=session)
+    assert result == {"text": "resposta remota", "provider": "groq"}
+    ollama.assert_not_called()
+
+
+def test_modo_auto_preserva_fallback_configurado(monkeypatch):
+    monkeypatch.setenv("IA_MODO", "auto")
+    monkeypatch.setenv("FRIDAY_HYBRID_ORDER", "local_first")
+    monkeypatch.setenv("FRIDAY_HYBRID_CLOUD_FALLBACK", "no")
+    monkeypatch.setenv("GROQ_API_KEY", "test-key")
+    session = Mock()
+    session.post.side_effect = OSError("offline")
+    with patch.object(ponte_ia, "_groq") as groq:
+        with pytest.raises(ponte_ia.PonteIAError):
+            ponte_ia.responder("oi", session=session)
+    groq.assert_not_called()
