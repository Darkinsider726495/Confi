# ===== Servidor privado da FRIDAY =====
# Copie para .env e ajuste. Mantenha com permissão 600 (chmod 600 .env).

# IP FIXO do servidor na rede local (reserve esse IP no roteador). O DNS (AdGuard) escuta só nele.
LAN_IP=192.168.1.10
# Faixa da sua rede local (usada no firewall). Se vazio, assume a faixa /24 do LAN_IP.
# LAN_CIDR=192.168.1.0/24

# Onde os painéis (AdGuard, Uptime Kuma, ntfy) escutam.
#   127.0.0.1  = só no próprio servidor
#   100.x.y.z  = IP do Tailscale (tailscale ip -4): acessa de qualquer lugar, sem abrir porta no roteador
PAINEL_IP=127.0.0.1

# Onde o Ollama escuta. Deixe 127.0.0.1 se a FRIDAY roda no mesmo PC.
# Se a FRIDAY roda em outro aparelho (ex.: Raspberry Pi), use o IP do Tailscale do servidor.
OLLAMA_BIND=127.0.0.1
OLLAMA_MEM=20g

# Endereço que o celular usa para falar com o ntfy (IP do Tailscale + porta 2586)
NTFY_BASE_URL=http://100.x.y.z:2586
TZ=America/Sao_Paulo

# Token do ntfy (criado em instalar.sh / README) usado pelo backup para avisar falhas
NTFY_URL=
NTFY_TOKEN=

# ===== Backup (restic) =====
# Local (disco USB):  /mnt/backup/friday      Nuvem:  s3:s3.amazonaws.com/seu-bucket  ou  b2:seu-bucket:friday
RESTIC_REPOSITORY=/mnt/backup/friday
RESTIC_PASSWORD_FILE=/etc/friday/restic-senha
# Para S3/B2 acrescente as chaves de acesso do provedor:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===== Versões das imagens =====
# Depois do primeiro "docker compose pull", rode "bash fixar-versoes.sh": ele grava aqui o digest
# exato de cada imagem, para o servidor não mudar sozinho. (Sem isso, vale a etiqueta padrão do compose.)
# IMG_ADGUARD=
# IMG_KUMA=
# IMG_NTFY=
# IMG_OLLAMA=
