# Servidor de voz da FRIDAY. O instalar-voz.sh copia este arquivo para .env e gera o VOZ_TOKEN. Mantenha chmod 600.

# Chave que o celular usa (mín. 16 caracteres). Use o mesmo valor em VOZ_TOKEN no .env da FRIDAY.
VOZ_TOKEN=troque-esta-chave
# Onde escutar: 127.0.0.1 (só este aparelho), IP do Tailscale ou IP fixo da rede local. Nunca 0.0.0.0 sem firewall.
VOZ_BIND=127.0.0.1
VOZ_PORTA=8765

# --- Ouvido (faster-whisper) ---
# tiny/base: rápido, erra mais; small: bom equilíbrio no CPU (padrão); medium/large-v3/turbo: melhores, pedem GPU ou CPU forte
STT_MODELO=small
# auto, cpu ou cuda. compute: auto (padrão), int8 (CPU fraco), float16 (GPU)
STT_DEVICE=auto
STT_COMPUTE=auto
STT_IDIOMA=pt
# Onde ficam os modelos baixados (o instalar-voz.sh preenche com a pasta "modelos" daqui)
# HF_HOME=/caminho/modelos

# --- Voz (Kokoro) ---
# p = português do Brasil. Vozes: pm_alex (masculina, padrão), pf_dora, pm_santa
KOKORO_IDIOMA=p
KOKORO_VOZ=pm_alex
KOKORO_VELOCIDADE=1.0

# Desligar uma metade: VOZ_STT=0 ou VOZ_TTS=0
