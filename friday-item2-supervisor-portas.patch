 export FRIDAY_HEARTBEAT="${FRIDAY_HEARTBEAT:-$DIR/friday/.heartbeat}"
-PORTA="${HUD_PORTA:-8080}"
+# Lê apenas atribuições simples do .env; não executa o arquivo como código shell.
+ler_env() {
+  [ -r "$DIR/.env" ] || return 0
+  while IFS= read -r linha || [ -n "$linha" ]; do
+    case "$linha" in
+      "$1"=*) printf '%s' "${linha#*=}"; return 0 ;;
+    esac
+  done < "$DIR/.env"
+}
+HUD_PORTA="${HUD_PORTA:-$(ler_env HUD_PORTA)}"
+PORTA="${HUD_PORTA:-8081}"
+case "$PORTA" in
+  ''|*[!0-9]*) PORTA=8081 ;;
+esac
+if [ "$PORTA" -lt 1 ] || [ "$PORTA" -gt 65535 ]; then PORTA=8081; fi
 CHECK="${CHECK_INTERVAL:-30}"; STALE="${STALE_SEGUNDOS:-180}"; GRACE="${GRACE_SEGUNDOS:-120}"
 PY="${FRIDAY_PY:-python}"; ARGS="${FRIDAY_ARGS:-friday/main.py --android}"
 PIDF="${FRIDAY_PIDFILE:-$DIR/.supervisor.pid}"
